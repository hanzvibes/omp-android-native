index 0000000..0000000 100644
--- a/crates/pi-vfs/src/fs.rs
+++ b/crates/pi-vfs/src/fs.rs
@@ -505,10 +505,21 @@ fn helper_exited() -> io::Error {
 /// Whether this process may open `path` with `mode` (`R_OK`, `W_OK`), by its
 /// effective IDs.
 #[cfg(unix)]
 fn may_access(path: &Path, mode: libc::c_int) -> bool {
 	use std::os::unix::ffi::OsStrExt;
 	let Ok(path) = std::ffi::CString::new(path.as_os_str().as_bytes()) else {
 		return false;
 	};
 	// SAFETY: `path` is a NUL-terminated string alive for the call.
-	unsafe { libc::faccessat(libc::AT_FDCWD, path.as_ptr(), mode, libc::AT_EACCESS) == 0 }
+	// Android's libc crate does not expose AT_EACCESS. Android app processes
+	// normally have matching real/effective UIDs, so flags=0 preserves the
+	// intended access check without relying on the unavailable constant.
+	#[cfg(target_os = "android")]
+	let flags = 0;
+	// Other Unix targets retain the effective-ID behavior.
+	#[cfg(not(target_os = "android"))]
+	let flags = libc::AT_EACCESS;
+	unsafe { libc::faccessat(libc::AT_FDCWD, path.as_ptr(), mode, flags) == 0 }
 }
